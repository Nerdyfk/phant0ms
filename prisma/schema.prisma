datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Whitelist {
  id        String   @id @default(uuid())
  wallet    String   @unique
  discord   String?
  twitter   String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}
